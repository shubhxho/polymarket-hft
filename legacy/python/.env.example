# TypeSafe Jev — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest

# Rust replay is Base-only and needs no signing credentials.
# HFT_* settings below apply only to the archived Python prototype.

# Engine
HFT_MODE=paper
HFT_CITIES=nyc,london,tokyo,hong_kong,los_angeles,paris
HFT_DRY_RUN=true
HFT_MIN_EDGE=0.04
HFT_KELLY_FRACTION=0.25
HFT_MAX_ORDER_USD=25
HFT_MAX_CITY_USD=150
HFT_MAX_DAILY_LOSS_USD=75
HFT_METAR_POLL_MS=8000
HFT_INGEST_PORT=8787
